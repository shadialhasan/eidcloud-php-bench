{
    "name": "eidcloud/php-bench",
    "description": "Objective PHP runtime and framework benchmarking harness measuring RPS, latency, and memory with HTML charts in pure PHP",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Eng. MHD. Shadi AL-Hasan",
            "role": "Author & Maintainer"
        }
    ],
    "require": {
        "php": ">=8.2.0"
    },
    "autoload": {
        "psr-4": {
            "EidCloud\\PhpBench\\": "src/"
        }
    },
    "bin": [
        "bin/eidcloud-php-bench"
    ],
    "scripts": {
        "test": "php tests/run_tests.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
